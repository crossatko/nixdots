{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3,
    },
  },
  "display": {
    "separator": " ➜ ",
    "color": "blue",
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "OS      ",
    },
    {
      "type": "kernel",
      "key": "Kernel  ",
    },
    {
      "type": "uptime",
      "key": "Uptime  ",
    },
    {
      "type": "packages",
      "key": "Packages",
    },
    {
      "type": "localip",
      "key": "Local IP",
    },
    {
      "type": "wm",
      "key": "WM      ",
    },
    {
      "type": "terminal",
      "key": "Terminal",
    },
    {
      "type": "board",
      "key": "Mobo    ",
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU     ",
    },
    {
      "type": "gpu",
      "key": "GPU     ",
    },
    {
      "type": "memory",
      "key": "RAM     ",
    },
    {
      "type": "disk",
      "key": "SSD     ",
    },
    "break",
  ],
}
