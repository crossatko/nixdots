{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:14b": {
          "name": "Qwen 3 14B – local"
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B – good tools"
        },
        "deepseek-r1:14b": {
          "name": "DeepSeek R1 14B"
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B – strong tool caller"
        },
        "devstral-small-2": {
          "name": "Devstral Small 2 – coding specialist"
        }
      }
    }
  },
  // Optional – you can set a default model so you don't have to type --model every time
  "model": "ollama/qwen2.5-coder:14b"
}
